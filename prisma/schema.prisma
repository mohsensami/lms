// Prisma schema — migrated from Mongoose/MongoDB to PostgreSQL (Neon)
//
// NOTE: Prisma field names can't start with an underscore, so the primary
// key here is the standard `id`. The already-finished frontend/UI code
// reads `._id` directly all over the app (e.g. `course._id.toString()`), so
// instead of touching every one of those call sites, `lib/prisma.js` wraps
// the Prisma Client with an extension that automatically renames `id` to
// `_id` (recursively, including nested `include`d relations) on every
// query result. Nothing outside the DB layer needed to change.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id             String   @id @default(cuid())
  firstName      String
  lastName       String
  password       String
  email          String   @unique
  role           String   // "student" | "admin" (only these two roles exist)
  phone          String?
  bio            String?  @default("")
  socialMedia    Json?
  profilePicture String?
  designation    String?  @default("")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  coursesTaught Course[]      @relation("CourseInstructor")
  enrollments   Enrollment[]
  testimonials  Testimonial[]
  reports       Report[]
  watches       Watch[]
  orders        Order[]
  postsAuthored Post[]        @relation("PostAuthor")
  postComments  PostComment[]
  certificateRequests CertificateRequest[] @relation("CertificateRequestStudent")
  tickets        Ticket[]
  ticketMessages TicketMessage[]
}

model Category {
  id          String  @id @default(cuid())
  title       String
  description String?
  thumbnail   String

  courses Course[]
}

model Course {
  id         String   @id @default(cuid())
  title      String
  subtitle   String?  @default("subtitle")
  description String
  thumbnail  String?
  price      Float    @default(0)
  discountPrice Float?
  discountEndsAt DateTime?
  active     Boolean  @default(false)
  learning   String[] @default([])
  createdOn  DateTime @default(now())
  modifiedOn DateTime @updatedAt

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  instructorId String?
  instructor   User?   @relation("CourseInstructor", fields: [instructorId], references: [id], onDelete: SetNull)

  quizSetId String?
  quizSet   Quizset? @relation(fields: [quizSetId], references: [id])

  modules      Module[]
  testimonials Testimonial[]
  enrollments  Enrollment[]
  reports      Report[]
  orders       Order[]
  certificateRequests CertificateRequest[]
}

model Module {
  id          String  @id @default(cuid())
  title       String
  description String?
  active      Boolean @default(false)
  slug        String
  order       Int

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // Relation field intentionally named `lessonIds` to match existing
  // frontend usage of `module.lessonIds`.
  lessonIds Lesson[]
  watches   Watch[]
}

model Lesson {
  id          String  @id @default(cuid())
  title       String
  description String?
  duration    Int     @default(0)
  video_url   String?
  active      Boolean @default(false)
  slug        String
  access      String  @default("private")
  order       Int

  attachmentUrl  String?
  attachmentName String?

  // --- Private video storage -------------------------------------------
  // Videos uploaded through the admin panel live in a private bucket and
  // are NEVER exposed by URL. We only store which provider holds the file
  // (so changing the active provider later doesn't break old lessons) and
  // the object key. Playback goes through /api/video/[lessonId], which
  // checks access and returns a short-lived signed URL.
  videoProvider    String? // "tigris" | "s3" | "r2" | ...
  videoKey         String?
  // Only for providers that serve a public link (Cloudinary, UploadThing).
  // Never sent to the browser: /api/video/[lessonId] hands it out after the
  // access check. S3-style providers leave this empty and use signed URLs.
  videoUrl         String?
  videoName        String?
  videoSize        Float?
  videoContentType String?

  moduleId String?
  module   Module? @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  watches Watch[]
}

model Quizset {
  id          String  @id @default(cuid())
  title       String
  description String?
  slug        String?
  active      Boolean @default(false)

  // Relation field intentionally named `quizIds` to match existing
  // frontend usage of `quizSet.quizIds`.
  quizIds Quiz[]
  courses Course[]
}

model Quiz {
  id           String   @id @default(cuid())
  title        String
  description  String?
  slug         String?
  explanations String?
  options      Json?
  mark         Int      @default(5)
  createdAt    DateTime @default(now())

  quizsetId String?
  quizset   Quizset? @relation(fields: [quizsetId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id              String    @id @default(cuid())
  enrollment_date DateTime
  status          String
  completion_date DateTime?
  method          String

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  studentId String?
  student   User?   @relation(fields: [studentId], references: [id], onDelete: SetNull)
}

// Records every payment attempt (invoice) so the user's "Order" tab can show
// paid/unpaid invoices, and so failed/abandoned Zarinpal payments aren't
// silently lost like before (previously only a successful payment produced
// any record at all, via Enrollment).
model Order {
  id        String    @id @default(cuid())
  amount    Float
  status    String    @default("pending") // pending | paid | failed
  method    String    @default("zarinpal")
  authority String?   @unique
  refId     String?
  createdAt DateTime  @default(now())
  paidAt    DateTime?

  // Bale Pay only: the Bale chat that started the payment, and the Bale
  // transaction id (used to double-check a payment with inquireTransaction).
  baleChatId    String?
  transactionId String?
  payUrl        String? // Bale: where the customer completes the payment

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Testimonial {
  id      String @id @default(cuid())
  content String
  rating  Int
  status  String @default("pending") // pending | approved | rejected
  createdAt DateTime @default(now())

  reply       String?
  repliedAt   DateTime?
  repliedById String?

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Assessment {
  id         String @id @default(cuid())
  assessments Json
  otherMarks Int    @default(0)

  report Report?
}

model Report {
  id                     String    @id @default(cuid())
  totalCompletedLessons  String[]  @default([])
  totalCompletedModeules String[]  @default([])
  completion_date        DateTime?

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  studentId String?
  student   User?   @relation(fields: [studentId], references: [id], onDelete: SetNull)

  quizAssessmentId String?     @unique
  quizAssessment   Assessment? @relation(fields: [quizAssessmentId], references: [id])
}

model Watch {
  id         String   @id @default(cuid())
  state       String   @default("started")
  created_at  DateTime @default(now())
  modified_at DateTime @default(now())
  lastTime    Int      @default(0)

  lessonId String?
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  moduleId String?
  module   Module? @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Post {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  content    String
  thumbnail  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Publishing workflow (WordPress-style). A post is publicly visible only
  // when status = "published" AND publishedAt <= now. A future publishedAt
  // therefore means "scheduled"; status = "draft" is never public.
  status      String   @default("published") // draft | published
  publishedAt DateTime @default(now())

  // SEO fields (Yoast-style): editable per post from the admin panel.
  metaTitle       String?
  metaDescription String?
  focusKeyword    String?

  authorId String?
  author   User?         @relation("PostAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  comments PostComment[]

  // One category per post. Deleting a category keeps its posts (uncategorised).
  categoryId String?
  category   PostCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
}

// Blog categories, managed by admins under Posts -> Categories.
model PostCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())

  posts Post[]
}

// Comments on blog posts (separate from course Testimonials). Same
// moderation workflow: a comment stays "pending" until an admin approves it.
model PostComment {
  id        String   @id @default(cuid())
  content   String
  status    String   @default("pending") // pending | approved | rejected
  createdAt DateTime @default(now())

  reply       String?
  repliedAt   DateTime?
  repliedById String?

  postId String?
  post   Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// A student's request to have a completed course's certificate approved
// before they're allowed to download it. Reviewed by an admin.
model CertificateRequest {
  id         String    @id @default(cuid())
  status     String    @default("pending") // pending | approved | rejected
  requestedAt DateTime @default(now())
  decidedAt  DateTime?

  decidedById String?

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation("CertificateRequestStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
}

// Generic key/value store for admin-editable site settings
// (e.g. key = "storage", value = { activeProvider: "tigris" }).
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// Messages sent from the public "تماس با ما" form. Managed by admins in
// the dashboard (Messages): read / unread / delete.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("new") // new | read
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

// Support tickets: a student opens a ticket with a priority, admins see all
// tickets, answer them and close them. The conversation is a list of messages.
model Ticket {
  id        String   @id @default(cuid())
  number    Int      @unique @default(autoincrement()) // friendly number shown to people (#12)
  subject   String
  priority  String   @default("medium") // low | medium | high
  status    String   @default("open")   // open (waiting for staff) | answered (waiting for student) | closed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  messages TicketMessage[]

  @@index([status, updatedAt])
  @@index([userId])
}

model TicketMessage {
  id        String   @id @default(cuid())
  body      String
  isStaff   Boolean  @default(false)
  createdAt DateTime @default(now())

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
}
