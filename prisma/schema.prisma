// Prisma schema — migrated from Mongoose/MongoDB to PostgreSQL (Neon)
//
// NOTE: Prisma field names can't start with an underscore, so the primary
// key here is the standard `id`. The already-finished frontend/UI code
// reads `._id` directly all over the app (e.g. `course._id.toString()`), so
// instead of touching every one of those call sites, `lib/prisma.js` wraps
// the Prisma Client with an extension that automatically renames `id` to
// `_id` (recursively, including nested `include`d relations) on every
// query result. Nothing outside the DB layer needed to change.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id             String   @id @default(cuid())
  firstName      String
  lastName       String
  password       String
  email          String   @unique
  role           String
  phone          String?
  bio            String?  @default("")
  socialMedia    Json?
  profilePicture String?
  designation    String?  @default("")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  coursesTaught Course[]      @relation("CourseInstructor")
  enrollments   Enrollment[]
  testimonials  Testimonial[]
  reports       Report[]
  watches       Watch[]
  orders        Order[]
  postsAuthored Post[]        @relation("PostAuthor")
  postComments  PostComment[]
  certificateRequests CertificateRequest[] @relation("CertificateRequestStudent")
}

model Category {
  id          String  @id @default(cuid())
  title       String
  description String?
  thumbnail   String

  courses Course[]
}

model Course {
  id         String   @id @default(cuid())
  title      String
  subtitle   String?  @default("subtitle")
  description String
  thumbnail  String?
  price      Float    @default(0)
  discountPrice Float?
  active     Boolean  @default(false)
  learning   String[] @default([])
  createdOn  DateTime @default(now())
  modifiedOn DateTime @updatedAt

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  instructorId String?
  instructor   User?   @relation("CourseInstructor", fields: [instructorId], references: [id], onDelete: SetNull)

  quizSetId String?
  quizSet   Quizset? @relation(fields: [quizSetId], references: [id])

  modules      Module[]
  testimonials Testimonial[]
  enrollments  Enrollment[]
  reports      Report[]
  orders       Order[]
  certificateRequests CertificateRequest[]
}

model Module {
  id          String  @id @default(cuid())
  title       String
  description String?
  active      Boolean @default(false)
  slug        String
  order       Int

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // Relation field intentionally named `lessonIds` to match existing
  // frontend usage of `module.lessonIds`.
  lessonIds Lesson[]
  watches   Watch[]
}

model Lesson {
  id          String  @id @default(cuid())
  title       String
  description String?
  duration    Int     @default(0)
  video_url   String?
  active      Boolean @default(false)
  slug        String
  access      String  @default("private")
  order       Int

  attachmentUrl  String?
  attachmentName String?

  moduleId String?
  module   Module? @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  watches Watch[]
}

model Quizset {
  id          String  @id @default(cuid())
  title       String
  description String?
  slug        String?
  active      Boolean @default(false)

  // Relation field intentionally named `quizIds` to match existing
  // frontend usage of `quizSet.quizIds`.
  quizIds Quiz[]
  courses Course[]
}

model Quiz {
  id           String   @id @default(cuid())
  title        String
  description  String?
  slug         String?
  explanations String?
  options      Json?
  mark         Int      @default(5)
  createdAt    DateTime @default(now())

  quizsetId String?
  quizset   Quizset? @relation(fields: [quizsetId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id              String    @id @default(cuid())
  enrollment_date DateTime
  status          String
  completion_date DateTime?
  method          String

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  studentId String?
  student   User?   @relation(fields: [studentId], references: [id], onDelete: SetNull)
}

// Records every payment attempt (invoice) so the user's "Order" tab can show
// paid/unpaid invoices, and so failed/abandoned Zarinpal payments aren't
// silently lost like before (previously only a successful payment produced
// any record at all, via Enrollment).
model Order {
  id        String    @id @default(cuid())
  amount    Float
  status    String    @default("pending") // pending | paid | failed
  method    String    @default("zarinpal")
  authority String?   @unique
  refId     String?
  createdAt DateTime  @default(now())
  paidAt    DateTime?

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Testimonial {
  id      String @id @default(cuid())
  content String
  rating  Int
  status  String @default("pending") // pending | approved | rejected
  createdAt DateTime @default(now())

  reply       String?
  repliedAt   DateTime?
  repliedById String?

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Assessment {
  id         String @id @default(cuid())
  assessments Json
  otherMarks Int    @default(0)

  report Report?
}

model Report {
  id                     String    @id @default(cuid())
  totalCompletedLessons  String[]  @default([])
  totalCompletedModeules String[]  @default([])
  completion_date        DateTime?

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  studentId String?
  student   User?   @relation(fields: [studentId], references: [id], onDelete: SetNull)

  quizAssessmentId String?     @unique
  quizAssessment   Assessment? @relation(fields: [quizAssessmentId], references: [id])
}

model Watch {
  id         String   @id @default(cuid())
  state       String   @default("started")
  created_at  DateTime @default(now())
  modified_at DateTime @default(now())
  lastTime    Int      @default(0)

  lessonId String?
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  moduleId String?
  module   Module? @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Post {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  content    String
  thumbnail  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // SEO fields (Yoast-style): editable per post from the admin panel.
  metaTitle       String?
  metaDescription String?
  focusKeyword    String?

  authorId String?
  author   User?         @relation("PostAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  comments PostComment[]
}

// Comments on blog posts (separate from course Testimonials). Same
// moderation workflow: a comment stays "pending" until an admin approves it.
model PostComment {
  id        String   @id @default(cuid())
  content   String
  status    String   @default("pending") // pending | approved | rejected
  createdAt DateTime @default(now())

  reply       String?
  repliedAt   DateTime?
  repliedById String?

  postId String?
  post   Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// A student's request to have a completed course's certificate approved
// before they're allowed to download it. Reviewed by the course's
// instructor or any admin.
model CertificateRequest {
  id         String    @id @default(cuid())
  status     String    @default("pending") // pending | approved | rejected
  requestedAt DateTime @default(now())
  decidedAt  DateTime?

  decidedById String?

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation("CertificateRequestStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
}