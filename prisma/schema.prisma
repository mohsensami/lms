// Prisma schema — migrated from Mongoose/MongoDB to PostgreSQL (Neon)
//
// NOTE: Prisma field names can't start with an underscore, so the primary
// key here is the standard `id`. The already-finished frontend/UI code
// reads `._id` directly all over the app (e.g. `course._id.toString()`), so
// instead of touching every one of those call sites, `lib/prisma.js` wraps
// the Prisma Client with an extension that automatically renames `id` to
// `_id` (recursively, including nested `include`d relations) on every
// query result. Nothing outside the DB layer needed to change.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id             String   @id @default(cuid())
  firstName      String
  lastName       String
  password       String
  email          String   @unique
  role           String   // "student" | "admin" (only these two roles exist)
  phone          String?
  bio            String?  @default("")
  socialMedia    Json?
  profilePicture String?
  designation    String?  @default("")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  coursesTaught Course[]      @relation("CourseInstructor")
  enrollments   Enrollment[]
  testimonials  Testimonial[]
  orders        Order[]
  postsAuthored Post[]        @relation("PostAuthor")
  postComments  PostComment[]
  certificateRequests CertificateRequest[] @relation("CertificateRequestStudent")
  tickets        Ticket[]
  ticketMessages TicketMessage[]
  examAttempts   ExamAttempt[]
}

model Category {
  id          String  @id @default(cuid())
  title       String
  description String?
  thumbnail   String

  courses Course[]
}

model Course {
  id         String   @id @default(cuid())
  title      String
  subtitle   String?  @default("subtitle")
  description String
  thumbnail  String?
  price      Float    @default(0)
  discountPrice Float?
  discountEndsAt DateTime?
  active     Boolean  @default(false)
  learning   String[] @default([])
  createdOn  DateTime @default(now())
  modifiedOn DateTime @updatedAt

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  instructorId String?
  instructor   User?   @relation("CourseInstructor", fields: [instructorId], references: [id], onDelete: SetNull)

  // One final exam per course (managed by admins under «آزمون‌ها»).
  exam Exam?

  modules      Module[]
  testimonials Testimonial[]
  enrollments  Enrollment[]
  orders       Order[]
  certificateRequests CertificateRequest[]
}

model Module {
  id          String  @id @default(cuid())
  title       String
  description String?
  active      Boolean @default(false)
  slug        String
  order       Int

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // Relation field intentionally named `lessonIds` to match existing
  // frontend usage of `module.lessonIds`.
  lessonIds Lesson[]
}

model Lesson {
  id          String  @id @default(cuid())
  title       String
  description String?
  duration    Int     @default(0)
  video_url   String?
  active      Boolean @default(false)
  slug        String
  access      String  @default("private")
  order       Int

  attachmentUrl  String?
  attachmentName String?

  // --- Private video storage -------------------------------------------
  // Videos uploaded through the admin panel live in a private bucket and
  // are NEVER exposed by URL. We only store which provider holds the file
  // (so changing the active provider later doesn't break old lessons) and
  // the object key. Playback goes through /api/video/[lessonId], which
  // checks access and returns a short-lived signed URL.
  videoProvider    String? // "tigris" | "s3" | "r2" | ...
  videoKey         String?
  // Only for providers that serve a public link (Cloudinary, UploadThing).
  // Never sent to the browser: /api/video/[lessonId] hands it out after the
  // access check. S3-style providers leave this empty and use signed URLs.
  videoUrl         String?
  videoName        String?
  videoSize        Float?
  videoContentType String?

  moduleId String?
  module   Module? @relation(fields: [moduleId], references: [id], onDelete: Cascade)

}

// ---------------------------------------------------------------------------
// Final exam (the requirement for getting a certificate).
// An admin creates ONE exam per course: 4-option questions, a time limit and
// the number of correct answers needed to pass. A student who fails (or runs
// out of time) is locked out of the exam — and therefore of requesting a
// certificate — for 7 days.
// ---------------------------------------------------------------------------
model Exam {
  id              String   @id @default(cuid())
  title           String
  description     String?
  durationMinutes Int      // time limit for one attempt
  requiredCorrect Int      // correct answers needed to pass
  active          Boolean  @default(false) // students only see published exams
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  courseId String @unique
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  questions ExamQuestion[]
  attempts  ExamAttempt[]
}

model ExamQuestion {
  id           String   @id @default(cuid())
  text         String
  options      String[] // always exactly 4 options
  correctIndex Int      // 0-3: index of the correct option (never sent to students)
  order        Int      @default(0)

  examId String
  exam   Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId, order])
}

// One try of a student at an exam. `deadline` is fixed by the server when the
// attempt starts, so the time limit can't be cheated from the browser.
model ExamAttempt {
  id              String    @id @default(cuid())
  status          String    @default("in_progress") // in_progress | passed | failed
  startedAt       DateTime  @default(now())
  deadline        DateTime
  finishedAt      DateTime?
  correctCount    Int       @default(0)
  totalQuestions  Int       @default(0)
  requiredCorrect Int       @default(0) // snapshot of the exam's requirement
  timedOut        Boolean   @default(false)
  answers         Json?     // { [questionId]: selectedIndex }

  examId String
  exam   Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([examId, studentId, startedAt])
}

model Enrollment {
  id              String    @id @default(cuid())
  enrollment_date DateTime
  status          String
  completion_date DateTime?
  method          String

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  studentId String?
  student   User?   @relation(fields: [studentId], references: [id], onDelete: SetNull)
}

// Records every payment attempt (invoice) so the user's "Order" tab can show
// paid/unpaid invoices, and so failed/abandoned Zarinpal payments aren't
// silently lost like before (previously only a successful payment produced
// any record at all, via Enrollment).
model Order {
  id        String    @id @default(cuid())
  amount    Float
  status    String    @default("pending") // pending | paid | failed
  method    String    @default("zarinpal")
  authority String?   @unique
  refId     String?
  createdAt DateTime  @default(now())
  paidAt    DateTime?

  // Bale Pay only: the Bale chat that started the payment, and the Bale
  // transaction id (used to double-check a payment with inquireTransaction).
  baleChatId    String?
  transactionId String?
  payUrl        String? // Bale: where the customer completes the payment

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Testimonial {
  id      String @id @default(cuid())
  content String
  rating  Int
  status  String @default("pending") // pending | approved | rejected
  createdAt DateTime @default(now())

  reply       String?
  repliedAt   DateTime?
  repliedById String?

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Post {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  content    String
  thumbnail  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Publishing workflow (WordPress-style). A post is publicly visible only
  // when status = "published" AND publishedAt <= now. A future publishedAt
  // therefore means "scheduled"; status = "draft" is never public.
  status      String   @default("published") // draft | published
  publishedAt DateTime @default(now())

  // SEO fields (Yoast-style): editable per post from the admin panel.
  metaTitle       String?
  metaDescription String?
  focusKeyword    String?

  authorId String?
  author   User?         @relation("PostAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  comments PostComment[]

  // One category per post. Deleting a category keeps its posts (uncategorised).
  categoryId String?
  category   PostCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
}

// Blog categories, managed by admins under Posts -> Categories.
model PostCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())

  posts Post[]
}

// Comments on blog posts (separate from course Testimonials). Same
// moderation workflow: a comment stays "pending" until an admin approves it.
model PostComment {
  id        String   @id @default(cuid())
  content   String
  status    String   @default("pending") // pending | approved | rejected
  createdAt DateTime @default(now())

  reply       String?
  repliedAt   DateTime?
  repliedById String?

  postId String?
  post   Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// A student's request to have a completed course's certificate approved
// before they're allowed to download it. Reviewed by an admin.
model CertificateRequest {
  id         String    @id @default(cuid())
  status     String    @default("pending") // pending | approved | rejected
  requestedAt DateTime @default(now())
  decidedAt  DateTime?

  decidedById String?

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation("CertificateRequestStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
}

// Generic key/value store for admin-editable site settings
// (e.g. key = "storage", value = { activeProvider: "tigris" }).
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// Messages sent from the public "تماس با ما" form. Managed by admins in
// the dashboard (Messages): read / unread / delete.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("new") // new | read
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

// Support tickets: a student opens a ticket with a priority, admins see all
// tickets, answer them and close them. The conversation is a list of messages.
model Ticket {
  id        String   @id @default(cuid())
  number    Int      @unique @default(autoincrement()) // friendly number shown to people (#12)
  subject   String
  priority  String   @default("medium") // low | medium | high
  status    String   @default("open")   // open (waiting for staff) | answered (waiting for student) | closed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  messages TicketMessage[]

  @@index([status, updatedAt])
  @@index([userId])
}

model TicketMessage {
  id        String   @id @default(cuid())
  body      String
  isStaff   Boolean  @default(false)
  createdAt DateTime @default(now())

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
}
